# Public
NEXT_PUBLIC_SITE_NAME="Insights Curry"
NEXT_PUBLIC_SITE_URL="https://insightscurry.com"
# Public contact address — every mailto: link and the contact page read this
# (lib/site-config.ts). Also the default recipient for contact-form submissions.
NEXT_PUBLIC_CONTACT_EMAIL="support@insightscurry.com"

# Data layer — uncomment/add only what this specific project needs.
# Confirm with Swarn before adding real values; see "Before writing code"
# in the nextjs-dev-standards skill (DB/ORM, CMS, AI — none assumed).
# DATABASE_URL=
# CMS_API_TOKEN=
# AI_API_KEY=

# Auth / UAM — not part of this template yet.
# Will be added once the paired Python backend template defines the
# JWT/role contract (Admin + User by default) — see nextjs-dev-standards
# skill and claude-workflow-setup notes.

# Contact form (Resend) — app/api/contact/route.ts
# RESEND_API_KEY: from your Resend account. The same key works across
# environments; sending from a custom address (not onboarding@resend.dev)
# needs that domain verified in Resend first.
RESEND_API_KEY=
# Verified sender address once a domain is verified in Resend. Until then,
# Resend's own onboarding@resend.dev works for testing.
CONTACT_FROM_EMAIL="Insights Curry Website <onboarding@resend.dev>"
# Optional override: where submissions get sent (comma-separate multiple).
# Leave empty to use NEXT_PUBLIC_CONTACT_EMAIL. With a test Resend key and no
# verified domain, Resend only delivers to that account's own email.
CONTACT_TO_EMAIL=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty = analytics off.
# Only active in production builds (npm run build + npm run start).
NEXT_PUBLIC_GA_ID=
# Optional: Search Console HTML-tag verification code(s), comma-separated,
# one per owner. Not needed if owners verify through Google Analytics.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
